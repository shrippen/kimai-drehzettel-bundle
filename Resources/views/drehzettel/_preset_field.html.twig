{# A dropdown of common values that becomes a free number field in Erweitert mode (see the
   page-wide Einfach/Erweitert switch in ruleset_form.html.twig, which drives every field on the
   page at once - there is no per-field control here). Select and input share one `name`; a
   disabled control is excluded from form submission, so exactly one of the two is ever sent.

   presets: list of numbers. empty_label: set to allow "not set" (null) as
   its own option, e.g. for a surcharge that otherwise pools into weekly
   overtime. #}
{% macro field(name, label, presets, value, unit, empty_label) %}
    {% set is_empty = empty_label is not null and (value is null or value == '') %}
    {% set is_preset = not is_empty and value is not null and value in presets %}
    {% set is_custom = not is_empty and not is_preset %}
    <div class="mb-3">
        <label class="form-label">{{ label }}</label>
        <div class="d-flex align-items-center gap-2">
            <select name="{{ name }}" class="form-select form-select-sm dz-preset-select{{ is_custom ? ' d-none' }}" data-preset-for="{{ name }}" {% if is_custom %}disabled{% endif %}>
                {% if empty_label is not null %}<option value="" {% if is_empty %}selected{% endif %}>{{ empty_label }}</option>{% endif %}
                {% for p in presets %}<option value="{{ p }}" {% if is_preset and value == p %}selected{% endif %}>{{ p }}{{ unit }}</option>{% endfor %}
            </select>
            <input type="number" step="0.01" name="{{ name }}" class="form-control form-control-sm dz-custom-input{{ is_custom ? '' : ' d-none' }}" data-custom-for="{{ name }}" value="{{ is_custom ? value : '' }}" {% if not is_custom %}disabled{% endif %}>
        </div>
    </div>
{% endmacro %}

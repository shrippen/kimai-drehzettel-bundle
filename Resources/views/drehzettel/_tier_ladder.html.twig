{# Visual summary of a tier list (daily or weekly overtime): a proportional bar showing
   where each surcharge starts, plus small threshold marks. Server-rendered for the initial
   (no-JS) paint; from then on the script at the bottom of ruleset_form.html.twig owns this
   `id` element and rebuilds it live from the current field values - see rebuildLadder() there.
   The wrapper div always renders, even with zero tiers, so JS always has an anchor. #}
{% macro bar(id, tiers) %}
    {% set defined = [] %}
    {% for t in tiers %}
        {% if t.after is not null and t.after != '' %}
            {% set defined = defined|merge([t]) %}
        {% endif %}
    {% endfor %}
    <div class="dz-ladder" id="{{ id }}">
        {% if defined|length > 0 %}
            {% set maxAfter = defined|last.after %}
            {% set scale = maxAfter + (maxAfter > 20 ? 4 : 2) %}
            <div class="dz-ladder-bar">
                <div class="dz-ladder-seg dz-ladder-base" style="width:{{ (defined|first.after / scale * 100) }}%">0–{{ defined|first.after }}</div>
                {% for t in defined %}
                    {% set nextAfter = defined[loop.index] is defined ? defined[loop.index].after : scale %}
                    <div class="dz-ladder-seg dz-ladder-tier{{ min(loop.index, 4) }}" style="width:{{ ((nextAfter - t.after) / scale * 100) }}%">+{{ t.percent }}%</div>
                {% endfor %}
            </div>
            <div class="dz-ladder-marks">
                {% for t in defined %}
                    <div class="dz-ladder-mark" style="left:{{ (t.after / scale * 100) }}%">{{ t.after }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

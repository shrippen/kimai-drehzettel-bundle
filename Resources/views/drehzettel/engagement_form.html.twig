{# Engagement create/edit: Kimai modal (overview, week page), page without JS. #}
{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% embed (kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig') with {
        title: title,
        form: form,
        back: back,
        reset: false,
    } %}
        {% block form_body %}
            {% if form.user is defined %}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.user) }}</div>
                    <div class="col-md-6">{{ form_row(form.project) }}</div>
                </div>
                {{ form_row(form.ruleset) }}
            {% endif %}
            {{ form_row(form.role) }}
            <div class="row">
                <div class="col-md-4">{{ form_row(form.payKind) }}</div>
                <div class="col-md-4">{{ form_row(form.gage) }}</div>
                <div class="col-md-4">{{ form_row(form.cateringDeduction) }}</div>
            </div>
            <div class="row">
                <div class="col-md-6">{{ form_row(form.validFrom) }}</div>
                <div class="col-md-6">{{ form_row(form.validTo) }}</div>
            </div>
            {% if form.azv is defined %}{{ form_row(form.azv) }}{% endif %}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

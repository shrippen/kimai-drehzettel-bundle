{# Week PDF by mail: Kimai modal from the week page ("Mail" action), page without JS.
   Subject and text come from the engagement's template and can be changed before sending. #}
{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% embed (kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig') with {
        title: 'drehzettel.mail.title'|trans,
        form: form,
        back: back,
        reset: false,
        submit_button: 'drehzettel.mail.send',
    } %}
        {% block form_body %}
            {{ form_row(form.to) }}
            {{ form_row(form.subject) }}
            {{ form_row(form.body) }}
            {{ form_rest(form) }}
            <a href="{{ settings_url }}" class="modal-ajax-form">{{ 'drehzettel.mail.settings_link'|trans }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}

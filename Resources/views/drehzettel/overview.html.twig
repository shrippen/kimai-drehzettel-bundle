{% extends 'base.html.twig' %}
{% import '@Drehzettel/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'css'} %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'js'} %}
{% endblock %}

{% block main %}
    {% if engagements is empty %}
        {% if manages %}
            {{ kit.empty_state('drehzettel.overview.empty'|trans, path('drehzettel_engagement_new'), 'drehzettel.engagement.new'|trans, 'modal-ajax-form') }}
        {% else %}
            {{ kit.empty_state('drehzettel.overview.empty_own'|trans) }}
        {% endif %}
    {% else %}
        {% set columns = {
            'project': {class: 'alwaysVisible', orderBy: false, title: 'drehzettel.project'},
            'role': {class: 'd-none d-sm-table-cell', orderBy: false, title: 'drehzettel.role'},
            'user': {class: manages ? 'd-none d-md-table-cell' : 'd-none', orderBy: false, title: 'drehzettel.user'},
            'ruleset': {class: 'd-none d-lg-table-cell', orderBy: false, title: 'drehzettel.ruleset'},
            'valid_from': {class: 'd-none d-md-table-cell w-min text-nowrap', orderBy: false, title: 'drehzettel.valid_from'},
            'valid_to': {class: 'd-none d-md-table-cell w-min text-nowrap', orderBy: false, title: 'drehzettel.valid_to'},
            'actions': {class: 'actions alwaysVisible', orderBy: false},
        } %}
        {{ tables.datatable_header('drehzettel_engagements', columns, null, {boxClass: 'card', columnConfig: false, sticky: false}) }}
            {% for e in engagements %}
                {% set ended = e.validTo and e.validTo < today %}
                <tr{% if ended %} class="text-secondary"{% endif %}>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'project') }}">
                        <a href="{{ path('drehzettel_week', {id: e.id}) }}">{{ e.project.name }}</a>
                        <div class="d-sm-none small text-secondary">{{ e.role }}</div>
                    </td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'role') }}">{{ e.role }}</td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'user') }}">{{ e.user.displayName }}</td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'ruleset') }}">{{ e.rulesetName }}</td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'valid_from') }}">{{ e.validFrom|date_short }}</td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'valid_to') }}">{{ e.validTo ? e.validTo|date_short : '–' }}</td>
                    <td class="{{ datatable_column_class('drehzettel_engagements', 'actions') }}">
                        {% set event = actions(app.user, 'drehzettel_engagement', 'index', {engagement: e}) %}
                        {{ widgets.table_actions(event.actions) }}
                    </td>
                </tr>
            {% endfor %}
        {{ tables.data_table_footer(null, null, null) }}
    {% endif %}
{% endblock %}

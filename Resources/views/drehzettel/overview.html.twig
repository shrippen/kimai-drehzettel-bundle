{% extends 'base.html.twig' %}

{% block page_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{{ 'drehzettel.menu'|trans }}</h2>
        <span>
            <a href="{{ path('drehzettel_signature') }}" class="btn btn-sm btn-outline-secondary">{{ 'drehzettel.signature'|trans }}</a>
            {% if manages %}
                <a href="{{ path('drehzettel_ruleset_list') }}" class="btn btn-sm btn-outline-secondary">{{ 'drehzettel.rulesets'|trans }}</a>
                <a href="{{ path('drehzettel_engagement_new') }}" class="btn btn-sm btn-primary">{{ 'drehzettel.engagement.new'|trans }}</a>
            {% endif %}
        </span>
    </div>

    {% if engagements is empty %}
        <p class="text-muted">{{ 'drehzettel.overview.empty'|trans }}</p>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            {% if manages %}<th>{{ 'drehzettel.user'|trans }}</th>{% endif %}
                            <th>{{ 'drehzettel.project'|trans }}</th>
                            <th>{{ 'drehzettel.role'|trans }}</th>
                            <th>{{ 'drehzettel.ruleset'|trans }}</th>
                            <th>{{ 'drehzettel.valid_from'|trans }}</th>
                            <th>{{ 'drehzettel.valid_to'|trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for e in engagements %}
                        <tr{% if e.validTo and e.validTo < today %} class="text-muted"{% endif %}>
                            {% if manages %}<td>{{ e.user.displayName }}</td>{% endif %}
                            <td>{{ e.project.name }}</td>
                            <td>{{ e.role }}</td>
                            <td>{{ e.rulesetName }}</td>
                            <td>{{ e.validFrom|date('Y-m-d') }}</td>
                            <td>{{ e.validTo ? e.validTo|date('Y-m-d') : '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('drehzettel_week', {id: e.id}) }}" class="btn btn-xs btn-primary">{{ 'drehzettel.open'|trans }}</a>
                                {% if manages %}
                                    <a href="{{ path('drehzettel_engagement_edit', {id: e.id}) }}" class="btn btn-xs btn-outline-secondary">{{ 'action.edit'|trans }}</a>
                                    <a href="{{ path('drehzettel_engagement_rules', {id: e.id}) }}" class="btn btn-xs btn-outline-secondary">{{ 'drehzettel.rules.edit'|trans }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}

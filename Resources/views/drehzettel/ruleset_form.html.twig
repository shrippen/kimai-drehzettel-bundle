{#
    Ruleset editor (RulesetType): custom templates and the snapshot of one engagement.
    A long editor, so a page with Kimai's form card instead of a modal (kimai-plugin-ui GUIDELINES 3.7).
    Hours and percent, not minutes and basis points; an empty tier or surcharge is not used.
    The tier ladders are drawn from the field values and redrawn while typing (script below);
    the order of tiers is checked by RulesetType on submit.
#}
{% extends 'base.html.twig' %}
{% import '@Drehzettel/_kit/macros.html.twig' as kit %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'css'} %}
    <style>
        .dz-ladder { margin-bottom: 1rem; }
        .dz-ladder-bar { display: flex; height: 2rem; border-radius: var(--tblr-border-radius); overflow: hidden; font-size: .75rem; font-weight: var(--tblr-font-weight-medium); }
        .dz-ladder-seg { display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; }
        .dz-ladder-marks { position: relative; height: 1rem; }
        .dz-ladder-mark { position: absolute; top: 0; transform: translateX(-50%); font-size: .7rem; color: var(--tblr-secondary-color); white-space: nowrap; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'js'} %}
    <script>
    document.addEventListener('kimai.initialized', function () {
        const form = document.querySelector('form[name="ruleset"]');
        if (!form) {
            return;
        }

        const TIER_CLASSES = ['bg-yellow text-yellow-fg', 'bg-orange text-orange-fg', 'bg-red text-red-fg', 'bg-red text-red-fg'];

        const field = (name) => form.querySelector('[name="ruleset[' + name + ']"]');

        // Filled slots in field order; an unordered list draws nothing (RulesetType reports it on submit).
        const slots = (container) => {
            const list = [];
            for (let i = 1; i <= Number(container.dataset.slots); i++) {
                const after = field(container.dataset.prefix + i + 'After');
                const percent = field(container.dataset.prefix + i + 'Percent');
                if (!after || !percent || after.value.trim() === '' || percent.value.trim() === '' || isNaN(parseFloat(after.value))) {
                    continue;
                }
                list.push({after: parseFloat(after.value), afterText: after.value.trim(), percent: percent.value.trim()});
            }
            for (let i = 1; i < list.length; i++) {
                if (list[i].after <= list[i - 1].after) {
                    return [];
                }
            }
            return list;
        };

        const segment = (className, width, text) => {
            const el = document.createElement('div');
            el.className = 'dz-ladder-seg ' + className;
            el.style.width = width + '%';
            el.textContent = text;
            return el;
        };

        const draw = (container) => {
            const list = slots(container);
            container.replaceChildren();
            if (list.length === 0) {
                return;
            }
            const max = list[list.length - 1].after;
            const scale = max + (max > 20 ? 4 : 2);
            const bar = document.createElement('div');
            bar.className = 'dz-ladder-bar';
            bar.appendChild(segment('bg-secondary text-secondary-fg', list[0].after / scale * 100, '0–' + list[0].afterText));
            const marks = document.createElement('div');
            marks.className = 'dz-ladder-marks';
            list.forEach((tier, index) => {
                const next = index + 1 < list.length ? list[index + 1].after : scale;
                bar.appendChild(segment(TIER_CLASSES[Math.min(index, 3)], (next - tier.after) / scale * 100, '+' + tier.percent + ' %'));
                const mark = document.createElement('div');
                mark.className = 'dz-ladder-mark';
                mark.style.left = (tier.after / scale * 100) + '%';
                mark.textContent = tier.afterText;
                marks.appendChild(mark);
            });
            container.append(bar, marks);
        };

        const drawAll = () => document.querySelectorAll('.dz-ladder').forEach(draw);
        form.addEventListener('input', (event) => {
            if (/Tier\d(After|Percent)\]$/.test(event.target.name || '')) {
                drawAll();
            }
        });
        drawAll();
    });
    </script>
{% endblock %}

{% block page_intro %}
    {{ kit.context_line(context ?? []) }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% embed 'default/_form.html.twig' with {
        title: title,
        form: form,
        back: back,
        reset: false,
    } %}
        {% block form_body %}
            {% import '@Drehzettel/drehzettel/_ruleset_parts.html.twig' as parts %}
            <datalist id="{{ constant('KimaiPlugin\\DrehzettelBundle\\Form\\RulesetType::LIST_PERCENT') }}">
                {% for p in [25, 50, 75, 100] %}<option value="{{ p }}"></option>{% endfor %}
            </datalist>
            <datalist id="{{ constant('KimaiPlugin\\DrehzettelBundle\\Form\\RulesetType::LIST_BREAK') }}">
                {% for m in [0, 30, 45, 60] %}<option value="{{ m }}"></option>{% endfor %}
            </datalist>

            {% if form.name is defined %}
                {{ form_row(form.name) }}
            {% endif %}

            <fieldset class="form-fieldset">
                {{ parts.section('drehzettel.rules.break', 'drehzettel.rules.break_help') }}
                <div class="row">
                    <div class="col-md-4">{{ form_row(form.defaultBreakMinutes) }}</div>
                    <div class="col-md-4">{{ form_row(form.breakRule) }}</div>
                    <div class="col-md-4">{{ form_row(form.freeBreakMinutes) }}</div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                {{ parts.section('drehzettel.rules.rounding', 'drehzettel.rules.rounding_help') }}
                <div class="row">
                    <div class="col-sm-6 col-lg-3">{{ form_row(form.workRoundingUnit) }}</div>
                    <div class="col-sm-6 col-lg-3">{{ form_row(form.workRoundingMode) }}</div>
                    <div class="col-sm-6 col-lg-3">{{ form_row(form.surchargeRoundingUnit) }}</div>
                    <div class="col-sm-6 col-lg-3">{{ form_row(form.surchargeRoundingMode) }}</div>
                </div>
            </fieldset>

            {% for kind, slots in {dailyTier: 4, weeklyTier: 3} %}
                <fieldset class="form-fieldset">
                    {{ parts.section('drehzettel.rules.' ~ (kind == 'dailyTier' ? 'daily_tiers' : 'weekly_tiers'), 'drehzettel.rules.' ~ (kind == 'dailyTier' ? 'daily_help' : 'weekly_help')) }}
                    {{ parts.ladder(kind, slots, form.vars.value) }}
                    <div class="row">
                        {% for i in 1..slots %}
                            <div class="col-6 col-md-3">{{ form_row(form[kind ~ i ~ 'After']) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form[kind ~ i ~ 'Percent']) }}</div>
                        {% endfor %}
                    </div>
                    {% if kind == 'weeklyTier' %}
                        <div class="row">
                            <div class="col-md-4">{{ form_row(form.weeklyGageHours) }}</div>
                            <div class="col-md-4">{{ form_row(form.dailyGageHours) }}</div>
                            <div class="col-md-4">{{ form_row(form.minDayHours) }}</div>
                        </div>
                    {% endif %}
                </fieldset>
            {% endfor %}

            <fieldset class="form-fieldset">
                {{ parts.section('drehzettel.rules.night', 'drehzettel.rules.night_help') }}
                <div class="row">
                    <div class="col-6 col-md-4">{{ form_row(form.nightFrom) }}</div>
                    <div class="col-6 col-md-4">{{ form_row(form.nightTo) }}</div>
                    <div class="col-md-4">{{ form_row(form.nightPercent) }}</div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                {{ parts.section('drehzettel.rules.category', 'drehzettel.rules.category_help') }}
                <div class="row">
                    {% for cat in ['saturday', 'sunday', 'holiday'] %}
                        <div class="col-md-4">
                            {{ form_row(form[cat ~ 'Percent']) }}
                            {{ form_row(form[cat ~ 'Basis']) }}
                        </div>
                    {% endfor %}
                </div>
            </fieldset>

            <fieldset class="form-fieldset mb-0">
                {{ parts.section('drehzettel.rules.week_count', 'drehzettel.rules.week_count_help') }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.sixthDayPercent) }}</div>
                    <div class="col-md-6">{{ form_row(form.seventhDayPercent) }}</div>
                </div>
            </fieldset>

            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block page_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{{ 'drehzettel.rulesets'|trans }}</h2>
        <a href="{{ path('drehzettel_overview') }}" class="btn btn-sm btn-outline-secondary">{{ 'action.back'|trans }}</a>
    </div>

    <div class="card mb-3">
        <div class="card-header">{{ 'drehzettel.ruleset.builtin'|trans }}</div>
        <div class="card-body">
            <ul class="list-unstyled mb-0">
                {% for b in builtin %}
                    <li class="mb-1">
                        {{ b.name }}
                        <a href="{{ path('drehzettel_ruleset_new', {from: b.key}) }}" class="btn btn-xs btn-outline-secondary ms-2">{{ 'drehzettel.ruleset.copy'|trans }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="card">
        <div class="card-header">{{ 'drehzettel.ruleset.custom'|trans }}</div>
        <div class="card-body p-0">
            {% if custom is empty %}
                <p class="text-muted p-3 mb-0">{{ 'drehzettel.ruleset.none'|trans }}</p>
            {% else %}
                <table class="table mb-0">
                    <tbody>
                    {% for r in custom %}
                        <tr>
                            <td>{{ r.name }}</td>
                            <td class="text-end">
                                <a href="{{ path('drehzettel_ruleset_edit', {id: r.id}) }}" class="btn btn-xs btn-outline-secondary">{{ 'action.edit'|trans }}</a>
                                <a href="{{ path('drehzettel_ruleset_new', {from: r.name}) }}" class="btn btn-xs btn-outline-secondary">{{ 'drehzettel.ruleset.copy'|trans }}</a>
                                <form class="d-inline" method="post" action="{{ path('drehzettel_ruleset_delete', {id: r.id}) }}" onsubmit="return confirm('{{ 'drehzettel.ruleset.delete_confirm'|trans|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('drehzettel_ruleset') }}">
                                    <button class="btn btn-xs btn-outline-danger" type="submit">{{ 'action.delete'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}

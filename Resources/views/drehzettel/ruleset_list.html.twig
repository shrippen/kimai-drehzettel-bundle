{% extends 'base.html.twig' %}
{% import '@Drehzettel/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'css'} %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'js'} %}
{% endblock %}

{% block main %}
    {% set columns = {
        'name': {class: 'alwaysVisible', orderBy: false, title: 'drehzettel.ruleset.name'},
        'kind': {class: 'w-min text-nowrap', orderBy: false, title: 'drehzettel.ruleset.kind'},
        'actions': {class: 'actions alwaysVisible', orderBy: false},
    } %}
    {{ tables.datatable_header('drehzettel_rulesets', columns, null, {boxClass: 'card', columnConfig: false, sticky: false}) }}
        {% for r in rows %}
            <tr>
                <td class="{{ datatable_column_class('drehzettel_rulesets', 'name') }}">
                    <a href="{{ r.id ? path('drehzettel_ruleset_edit', {id: r.id}) : path('drehzettel_ruleset_view', {key: r.key}) }}">{{ r.name }}</a>
                </td>
                <td class="{{ datatable_column_class('drehzettel_rulesets', 'kind') }} text-secondary">
                    {{ (r.id ? 'drehzettel.ruleset.custom' : 'drehzettel.ruleset.builtin')|trans }}
                </td>
                <td class="{{ datatable_column_class('drehzettel_rulesets', 'actions') }}">
                    {% set event = actions(app.user, 'drehzettel_ruleset', 'index', {key: r.key, id: r.id}) %}
                    {{ widgets.table_actions(event.actions) }}
                </td>
            </tr>
        {% endfor %}
    {{ tables.data_table_footer(null, null, null) }}
{% endblock %}

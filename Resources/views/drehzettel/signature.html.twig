{# Own signature for timesheet PDFs: upload (replaces the stored one), remove via header action. #}
{% extends 'base.html.twig' %}

{% block main %}
    {% embed 'default/_form.html.twig' with {
        title: 'drehzettel.signature'|trans,
        form: form,
        back: path('drehzettel_overview'),
        reset: false,
        submit_button: 'drehzettel.signature.upload',
    } %}
        {% block form_body %}
            <p class="form-hint">{{ 'drehzettel.signature.help'|trans }}</p>
            {% if signature %}
                <div class="mb-3">
                    <div class="form-label">{{ 'drehzettel.signature.stored'|trans }}</div>
                    <img src="{{ signature }}" alt="{{ 'drehzettel.signature'|trans }}" class="img-fluid border rounded p-2 bg-white dz-signature">
                </div>
            {% endif %}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block page_content %}
    {% set e = v.engagement %}
    <style>
        .dz-stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.75rem;margin-bottom:1rem;}
        .dz-stat{background:var(--tblr-bg-surface,#fff);border:1px solid var(--tblr-border-color);border-radius:var(--tblr-border-radius-lg,10px);padding:.75rem 1rem;}
        .dz-stat-pay{background:var(--tblr-primary);border-color:var(--tblr-primary);}
        .dz-stat-label{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.03em;color:var(--tblr-secondary-color,#6b7280);margin-bottom:.2rem;}
        .dz-stat-pay .dz-stat-label{color:rgba(255,255,255,.75);}
        .dz-stat-value{font-size:1.3rem;font-weight:700;}
        .dz-stat-pay .dz-stat-value{color:#fff;}
        .dz-stat-chips{display:flex;flex-wrap:wrap;gap:.3rem;}
        .dz-compliance{display:flex;align-items:center;gap:.4rem;font-size:.8rem;color:var(--tblr-secondary-color,#6b7280);margin-bottom:.6rem;}
        .dz-compliance.dz-compliance-warn{color:var(--tblr-warning);}
        .dz-compliance ul{margin:.2rem 0 0;padding-left:1.1rem;}
        .dz-day-list{display:flex;flex-direction:column;}
        .dz-day-scroll{overflow-x:auto;}
        .dz-day-header, .dz-day-row{
            display:grid;
            grid-template-columns: 28px minmax(175px,1.1fr) 84px minmax(230px,1.3fr) minmax(70px,.6fr) minmax(230px,1.3fr) minmax(150px,1fr);
            align-items:center;
            column-gap:1.1rem;
            row-gap:.25rem;
            min-width:1075px;
        }
        .card.dz-pay .dz-day-header, .card.dz-pay .dz-day-row{
            grid-template-columns: 28px minmax(175px,1.1fr) 84px minmax(230px,1.3fr) minmax(70px,.6fr) minmax(230px,1.3fr) 80px minmax(150px,1fr);
            min-width:1170px;
        }
        .dz-day-header{padding:.6rem 1.25rem;border-bottom:1px solid var(--tblr-border-color);}
        .dz-day-header > div{font-size:.7rem!important;font-weight:600!important;text-transform:uppercase;letter-spacing:.04em;color:var(--tblr-secondary-color,#6b7280);white-space:nowrap;}
        .dz-day-header > .dz-day-extra{white-space:normal;line-height:1.2;}
        .dz-day-row{padding:.9rem 1.25rem;border-bottom:1px solid var(--tblr-border-color-translucent,#eee);}
        .dz-day-row:nth-child(even){background:var(--tblr-bg-surface-secondary,#f9fafb);}
        .dz-day-row:last-child{border-bottom:none;}
        .dz-day-row.dz-editing{background:var(--tblr-primary-lt,#e6f1fa);}
        .dz-day-row.dz-day-row-empty{grid-template-columns:1fr!important;display:flex!important;align-items:center;gap:1rem;}
        .dz-day-empty{color:var(--tblr-secondary-color,#9ca3af);font-size:.9rem;}
        .dz-day-weekday{font-size:.9rem;font-weight:600;}
        .dz-day-time{font-size:.8rem;color:var(--tblr-secondary-color,#6b7280);margin-top:.15rem;}
        .dz-break-input{width:3.4rem;display:inline-block;border:1px solid var(--tblr-border-color);border-radius:4px;padding:.15rem .3rem;font-size:.8rem;text-align:right;}
        .dz-day-work{text-align:right;font-size:1.1rem;font-weight:700;white-space:nowrap;}
        .dz-day-tiers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .5rem;}
        .dz-chip{display:inline-flex;align-items:center;justify-content:center;gap:.3rem;border-radius:6px;padding:.3rem .5rem;font-size:.76rem;font-weight:600;white-space:nowrap;}
        .dz-chip-off{background:var(--tblr-bg-surface-secondary,#f3f4f6);color:var(--tblr-secondary-color,#9ca3af);}
        .dz-chip-tier1{background:var(--tblr-warning-lt,#fef3e0);color:#9a6700;}
        .dz-chip-tier2{background:#ffe8d6;color:#b3540a;}
        .dz-chip-tier3, .dz-chip-tier4{background:var(--tblr-danger-lt,#fbeaea);color:#a72424;}
        .dz-chip-night{background:var(--tblr-info-lt,#eaf4fc);color:#1c5c8a;}
        .dz-chip-under{background:var(--tblr-warning-lt,#fef3e0);color:#9a6700;}
        .dz-chip-catering{background:var(--tblr-success-lt,#eaf7ec);color:#1c7a30;}
        .dz-day-extra{display:flex;gap:.4rem;flex-wrap:wrap;}
        .dz-catering{display:flex;align-items:center;gap:.4rem;font-size:.8rem;color:var(--tblr-secondary-color,#6b7280);}
        .dz-pill{border:1px solid var(--tblr-border-color);background:var(--tblr-bg-surface-secondary,#f9fafb);border-radius:100px;font-size:.8rem;padding:.35rem 1.6rem .35rem .7rem;}
        .dz-day-pay{text-align:right;font-size:.9rem;font-weight:600;}
        .dz-day-note input{padding:.45rem .6rem;}

        .dz-edit-toggle{border:none;background:transparent;color:var(--tblr-secondary-color,#9ca3af);cursor:pointer;padding:.25rem;border-radius:6px;line-height:1;}
        .dz-edit-toggle:hover{background:var(--tblr-bg-surface-secondary,#f3f4f6);color:var(--tblr-primary);}
        .dz-day-row.dz-editing .dz-edit-toggle{color:var(--tblr-primary);}
        .dz-edit-icon-check{display:none;}
        .dz-day-row.dz-editing .dz-edit-icon-pen{display:none;}
        .dz-day-row.dz-editing .dz-edit-icon-check{display:inline;}

        .dz-day-row .dz-edit{display:none;}
        .dz-day-row.dz-editing .dz-view{display:none;}
        .dz-day-row.dz-editing .dz-day-time .dz-edit{display:inline;}
        .dz-day-row.dz-editing .dz-day-actions .dz-edit{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;}
        .dz-day-row.dz-editing .dz-day-note .dz-edit{display:block;}
        .dz-day-actions .dz-view{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;font-size:.82rem;color:var(--tblr-secondary-color,#6b7280);}
        .dz-day-actions-empty{color:var(--tblr-secondary-color,#9ca3af);}
        .dz-day-note .dz-view{font-size:.85rem;color:var(--tblr-secondary-color,#6b7280);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;}
        .dz-week-poolline{padding:.4rem 1rem;font-size:.75rem;color:var(--tblr-secondary-color,#6b7280);background:var(--tblr-bg-surface-secondary,#f9fafb);border-top:1px solid var(--tblr-border-color-translucent,#eee);}
        .dz-week-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;padding:.65rem 1rem;background:var(--tblr-primary-lt,#e6f1fa);border-top:1px solid var(--tblr-border-color);border-radius:0 0 var(--tblr-border-radius-lg,10px) var(--tblr-border-radius-lg,10px);}
        .dz-week-footer-values{display:flex;gap:1.1rem;flex-wrap:wrap;}
        .dz-week-footer-values span{font-size:.8rem;color:var(--tblr-primary);}
        .dz-week-footer-values strong{font-size:1rem;}
    </style>

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <div>
            <h2 class="mb-0">{{ e.project.name }} — {{ e.role }}</h2>
            <span class="text-muted">{{ e.user.displayName }} · {{ v.monday|date('Y-m-d') }} – {{ v.sunday|date('Y-m-d') }} · {{ 'drehzettel.week.iso'|trans }} {{ v.week }}</span>
        </div>
        <div>
            <a href="{{ path('drehzettel_week', {id: e.id, year: v.previous.year, week: v.previous.week}) }}" class="btn btn-sm btn-outline-secondary">&laquo;</a>
            <a href="{{ path('drehzettel_week', {id: e.id, year: v.next.year, week: v.next.week}) }}" class="btn btn-sm btn-outline-secondary">&raquo;</a>
            <a href="{{ path('drehzettel_week_pdf', {id: e.id, year: v.year, week: v.week}) }}" class="btn btn-sm btn-primary" target="_blank">{{ 'drehzettel.pdf.title'|trans }}</a>
            <a href="{{ path('drehzettel_month_pdf', {id: e.id, year: v.year, month: v.monday|date('n')}) }}" class="btn btn-sm btn-outline-primary" target="_blank">{{ 'drehzettel.pdf.month'|trans }}</a>
        </div>
    </div>

    <div class="dz-stat-grid">
        <div class="dz-stat">
            <div class="dz-stat-label">{{ 'drehzettel.pdf.work'|trans }}</div>
            <div class="dz-stat-value">{{ v.sums.work }}</div>
        </div>
        <div class="dz-stat">
            <div class="dz-stat-label">{{ 'drehzettel.rules.surcharge_rounding'|trans }}</div>
            <div class="dz-stat-chips">
                {% for x in v.sums.tiers %}
                    <span class="dz-chip {{ x starts with '00:00' ? 'dz-chip-off' : 'dz-chip-tier' ~ min(loop.index, 4) }}">{{ v.columns.tiers[loop.index0] }} {{ x starts with '00:00' ? '–' : x }}</span>
                {% endfor %}
            </div>
        </div>
        <div class="dz-stat">
            <div class="dz-stat-label">{{ 'drehzettel.pdf.night'|trans }}</div>
            <div class="dz-stat-value">{{ v.sums.night }}</div>
        </div>
        {% if v.has_pay %}
            <div class="dz-stat dz-stat-pay">
                <div class="dz-stat-label">{{ 'drehzettel.pdf.pay'|trans }}</div>
                <div class="dz-stat-value">{{ v.sums.pay }}</div>
            </div>
        {% endif %}
    </div>

    {% if v.warnings is not empty %}
        <div class="dz-compliance dz-compliance-warn align-items-start">
            <i class="fas fa-triangle-exclamation mt-1"></i>
            <div>
                <strong>{{ 'drehzettel.compliance.title'|trans }}</strong>
                <ul>
                    {% for w in v.warnings %}
                        <li>{{ ('drehzettel.compliance.' ~ w.issue.value)|trans({'%date%': w.date|date('D, Y-m-d'), '%measured%': (w.minutes / 60)|number_format(1), '%limit%': (w.limitMinutes / 60)|number_format(1)}) }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% else %}
        <div class="dz-compliance"><i class="fas fa-circle-check text-success"></i> {{ 'drehzettel.week.compliance_ok'|trans }}</div>
    {% endif %}

    <form method="post" action="{{ path('drehzettel_week_save', {id: e.id, year: v.year, week: v.week}) }}" id="drehzettel-form">
        <input type="hidden" name="_token" value="{{ csrf_token('drehzettel_week') }}">
        <div class="card {{ v.columns.pay ? 'dz-pay' : '' }}">
            <div class="dz-day-scroll">
                <div class="dz-day-header">
                    <div class="dz-day-edit"></div>
                    <div class="dz-day-date">{{ 'drehzettel.pdf.date'|trans }}</div>
                    <div class="dz-day-work">{{ 'drehzettel.pdf.work'|trans }}</div>
                    <div class="dz-day-tiers">{{ 'drehzettel.rules.surcharge_rounding'|trans }}</div>
                    <div class="dz-day-extra">{{ 'drehzettel.pdf.night'|trans }} / {{ 'drehzettel.pdf.under'|trans }}</div>
                    <div class="dz-day-actions">{{ 'drehzettel.pdf.catering'|trans }} · {{ 'drehzettel.pdf.day_type'|trans }} · {{ 'drehzettel.category.title'|trans }}</div>
                    {% if v.columns.pay %}<div class="dz-day-pay">{{ 'drehzettel.pdf.pay'|trans }}</div>{% endif %}
                    <div class="dz-day-note">{{ 'drehzettel.note'|trans }}</div>
                </div>
                <div class="card-body p-0" id="drehzettel-table-wrap">
                    {% include '@Drehzettel/drehzettel/_week_table.html.twig' %}
                </div>
            </div>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mt-3">
        <form method="post" action="{{ path('drehzettel_week_mail', {id: e.id, year: v.year, week: v.week}) }}" class="d-flex align-items-end gap-2" style="max-width: 480px;">
            <input type="hidden" name="_token" value="{{ csrf_token('drehzettel_week') }}">
            <div class="flex-grow-1">
                <label class="form-label mb-1">{{ 'drehzettel.mail.to'|trans }}</label>
                <input type="email" name="mail_to" class="form-control form-control-sm" value="{{ v.mail_to }}" required>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary">{{ 'drehzettel.mail.send'|trans }}</button>
        </form>
        <button type="submit" form="drehzettel-form" class="btn btn-primary">{{ 'action.save'|trans }}</button>
    </div>

    <script>
    (function () {
        var form = document.getElementById('drehzettel-form');
        var wrap = document.getElementById('drehzettel-table-wrap');
        if (!form || !wrap) { return; }

        var previewUrl = {{ path('drehzettel_week_preview', {id: e.id, year: v.year, week: v.week})|json_encode|raw }};
        var timer = null;
        var editingKey = null;

        function schedulePreview() {
            if (timer) { window.clearTimeout(timer); }
            timer = window.setTimeout(runPreview, 400);
        }

        function applyEditingState() {
            if (!editingKey) { return; }
            var row = wrap.querySelector('.dz-day-row[data-key="' + CSS.escape(editingKey) + '"]');
            if (row) { row.classList.add('dz-editing'); }
        }

        function runPreview() {
            var data = new FormData(form);
            fetch(previewUrl, { method: 'POST', body: data, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (response) { return response.ok ? response.text() : null; })
                .then(function (html) { if (html !== null) { wrap.innerHTML = html; applyEditingState(); } })
                .catch(function () { /* preview is a convenience, ignore network errors */ });
        }

        wrap.addEventListener('input', function (event) {
            if (event.target.classList.contains('dz-field')) { schedulePreview(); }
        });
        wrap.addEventListener('change', function (event) {
            if (event.target.classList.contains('dz-field')) { schedulePreview(); }
        });

        // Per-row edit mode: click the pencil to reveal that row's editable fields.
        // Click it again (now a check mark) to save - there is no per-day save on the server,
        // only the one whole-week POST the big Speichern button also uses, so the check mark
        // submits that same form. That also means there is never a "some rows saved, some not"
        // state to resolve: any save (this or the big button) persists every row at once,
        // including whichever other rows are still open for editing.
        wrap.addEventListener('click', function (event) {
            var toggle = event.target.closest('.dz-edit-toggle');
            if (!toggle) { return; }
            var row = toggle.closest('.dz-day-row');
            if (!row) { return; }

            if (row.classList.contains('dz-editing')) {
                form.requestSubmit();
            } else {
                wrap.querySelectorAll('.dz-day-row.dz-editing').forEach(function (r) { r.classList.remove('dz-editing'); });
                row.classList.add('dz-editing');
                editingKey = row.dataset.key;
            }
        });
    })();
    </script>
{% endblock %}

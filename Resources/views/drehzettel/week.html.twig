{% extends 'base.html.twig' %}
{% import '@Drehzettel/_kit/macros.html.twig' as kit %}
{% set e = v.engagement %}

{% block stylesheets %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'css'} %}
    <style>
        /* Day grid edit mode: one row at a time shows its inputs instead of the summary. */
        .dz-week-table .dz-edit { display: none; }
        /* Tabler's .btn min-width calc() is invalid here (unitless line-height + rem), so the
           icon-only toggle collapsed to its border and its hover background showed as a thin line. */
        .dz-week-table .dz-edit-toggle { min-width: 2rem; justify-content: center; }
        .dz-week-table tr.dz-editing .dz-view { display: none; }
        .dz-week-table tr.dz-editing .dz-edit { display: inline-block; }
        .dz-week-table tr.dz-editing .dz-edit-fields { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
        .dz-week-table tr.dz-editing .dz-note .dz-edit { display: block; }
        .dz-week-table .dz-break-input { width: 5rem; }
        .dz-week-table .dz-extra-pay-input { width: 6.5rem; }
        .dz-week-table .dz-shooting-day-input { width: 4.5rem; }
        .dz-week-table .dz-edit-fields .form-select { width: auto; }
        .dz-week-table .dz-note { min-width: 10rem; max-width: 16rem; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Drehzettel/_kit/assets.html.twig' with {kpu_part: 'js'} %}
    <script>
    document.addEventListener('kimai.initialized', function () {
        const form = document.getElementById('drehzettel-form');
        const live = document.getElementById('dz-week-live');
        const failure = document.getElementById('dz-preview-error');
        if (!form || !live) {
            return;
        }

        // Live preview: recalculates while typing, without saving. Only the calculated
        // [data-dz-live] parts are replaced, the inputs stay untouched.
        let timer = null;
        const schedule = () => {
            window.clearTimeout(timer);
            timer = window.setTimeout(preview, 400);
        };

        const preview = () => {
            fetch(form.dataset.previewUrl, {method: 'POST', body: new FormData(form), headers: {'X-Requested-With': 'XMLHttpRequest'}})
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(response.statusText);
                    }
                    return response.text();
                })
                .then((html) => {
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    doc.querySelectorAll('[data-dz-live]').forEach((fresh) => {
                        const current = live.querySelector('[data-dz-live="' + CSS.escape(fresh.dataset.dzLive) + '"]');
                        if (current) {
                            current.innerHTML = fresh.innerHTML;
                        }
                    });
                    failure.classList.add('d-none');
                })
                .catch(() => failure.classList.remove('d-none'));
        };

        live.addEventListener('input', (event) => {
            if (event.target.classList.contains('dz-field')) {
                schedule();
            }
        });
        live.addEventListener('change', (event) => {
            if (event.target.classList.contains('dz-field')) {
                schedule();
            }
        });

        // Pencil: edit this row. Check mark: save the whole week (the only save there is,
        // so any save persists every row, including rows still open for editing).
        live.addEventListener('click', (event) => {
            const toggle = event.target.closest('.dz-edit-toggle');
            const row = toggle ? toggle.closest('tr.dz-day') : null;
            if (!row) {
                return;
            }
            if (row.classList.contains('dz-editing')) {
                form.requestSubmit();
                return;
            }
            live.querySelectorAll('tr.dz-editing').forEach((r) => r.classList.remove('dz-editing', 'table-active'));
            row.classList.add('dz-editing', 'table-active');
            const first = row.querySelector('.dz-field');
            if (first) {
                first.focus();
            }
        });

        // Modals (mail, engagement edit/delete) answer per kimai-plugin-ui GUIDELINES 3.6:
        // kpu.reload (kit.js) or 201 + x-modal-redirect (Kimai), no own listeners needed.
    });
    </script>
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block page_intro %}
    {{ kit.context_line([e.project.name, e.role, e.user.displayName, v.monday|date_short ~ ' – ' ~ v.sunday|date_short]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(
        ['week'],
        'week',
        'stats.workingTimeWeekShort'|trans({'%week%': v.week}) ~ ' · ' ~ v.year,
        path('drehzettel_week', {id: e.id, year: v.previous.year, week: v.previous.week}),
        path('drehzettel_week', {id: e.id, year: v.next.year, week: v.next.week}),
        v.is_current ? null : path('drehzettel_week', {id: e.id}),
        {}
    ) }}
{% endblock %}

{% block main %}
    <form method="post" id="drehzettel-form"
          action="{{ path('drehzettel_week_save', {id: e.id, year: v.year, week: v.week}) }}"
          data-preview-url="{{ path('drehzettel_week_preview', {id: e.id, year: v.year, week: v.week}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('drehzettel_week') }}">
        <div id="dz-preview-error" class="alert alert-danger d-none" role="alert" aria-live="polite">
            {{ 'drehzettel.week.preview_failed'|trans }}
        </div>
        <div id="dz-week-live">
            {% include '@Drehzettel/drehzettel/_week_table.html.twig' %}
        </div>
    </form>
{% endblock %}

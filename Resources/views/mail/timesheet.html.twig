{# HTML part of the timesheet mail: the text as paragraphs in a plain card, inline styles only
   (mail clients drop <style>). The text is the user's: always escaped. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; background: #f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f4f4f5;">
    <tr>
        <td align="center" style="padding: 24px 12px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background: #ffffff; border: 1px solid #e4e4e7; border-radius: 6px;">
                <tr>
                    <td style="padding: 28px 32px 8px 32px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.55; color: #18181b;">
                        {% for paragraph in paragraphs %}
                            <p style="margin: 0 0 14px 0;">{{ paragraph|nl2br }}</p>
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <td style="padding: 8px 32px 28px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" style="border: 1px solid #e4e4e7; border-radius: 4px; background: #fafafa;">
                            <tr>
                                <td style="padding: 10px 14px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: #3f3f46;">
                                    &#128206;&nbsp;{{ attachment }}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
